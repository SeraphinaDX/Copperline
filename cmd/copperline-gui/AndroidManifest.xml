<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.cerberusgames.copperline"
    android:versionCode="27"
    android:versionName="0.2.27">
    <application android:label="Copperline"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- Resize the chat viewport above the IME instead of panning the whole
             window. Fyne consumes the resulting content/keyboard insets. -->
        <activity android:name="org.golang.app.GoNativeActivity"
            android:label="Copperline"
            android:configChanges="orientation|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme">
            <meta-data android:name="android.app.lib_name" android:value="Copperline" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name="org.golang.app.FyneNotificationReceiver"
            android:exported="false" />
    </application>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
